# GitHub personal access token (optional but recommended to avoid rate limits)
GITHUB_TOKEN=ghp_your_token_here

# DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your_deepseek_key_here
# Model: deepseek-chat (V3, fast) or deepseek-reasoner (R1, smarter)
DEEPSEEK_MODEL=deepseek-chat

# Feishu custom bot webhook URL
# Create at: Feishu group → Settings → Bots → Add Custom Bot
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_hook_id

# How many days back to look — 7 for weekly, 1 for daily
DAYS_LOOKBACK=7

# ── Feishu Docs (optional) ────────────────────────────────────────────────────
# Required to write weekly report into a Feishu document.
# Create an app at https://open.feishu.cn/app → Custom App
# Permissions needed: docs:doc:create  docs:doc
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
